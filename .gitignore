# ── Manuscripts and reference papers — never committed ────────────────────────
*.tex
*.pdf

# ── Large regenerated outputs ─────────────────────────────────────────────────
# Trained checkpoints are regenerated by run_dl_training.sh. Fold 01 is kept as a
# sample so the repo is not entirely weightless.
artifacts/*
!artifacts/*/
artifacts/*/*
!artifacts/*/fold_01.p
!artifacts/*/fold_01_norm.p
!artifacts/*/fold_01.onnx
!artifacts/*/fold_01.onnx.data
!artifacts/*/fold_01.pt
!artifacts/*/fold_01_ckpt.pt
!artifacts/*/fold_01_val_metric.pt
!artifacts/*/lora_fold_01.pt
!artifacts/*/lora_fold_01_val_metric.pt
!artifacts/*/delta_p.p
!artifacts/deep_iekf/iekfnets.p

outputs/
logs/

# ── Hailo build products ──────────────────────────────────────────────────────
# Everything the DFC and the sweep generate. Regenerated by build_per_fold_hefs.py
# and run_full_benchmark.py; only the pipeline scripts and runtime_data_*.json
# are tracked.
scripts/positioning/hailo/full_benchmark_results/
scripts/positioning/hailo/**/_pre_per_fold/
scripts/positioning/hailo/**/*.onnx
scripts/positioning/hailo/**/*.onnx.data
scripts/positioning/hailo/**/*.pt
scripts/positioning/hailo/**/*.npz
scripts/positioning/hailo/**/*.csv
scripts/positioning/hailo/**/*.html
scripts/positioning/hailo/**/*.svg
scripts/positioning/hailo/docker/hailort-packages/*.whl
*.hef
*.har

# ── Datasets ──────────────────────────────────────────────────────────────────
# The KITTI extracts and the legacy .mat drives are tracked; anything else is not.
datasets/*
!datasets/lola_kitti/
!datasets/raw_kitti/

# ── Embedded toolchain build products (simplicity/) ───────────────────────────
*.o
*.d
*.ld
*.axf
*.bin
*.hex
*.map
*.s37
*.slsproj
*.prefs
*.hwconf
*.properties
*.cproject
*.project
simplicity/**/*.mk
simplicity/Inartrans_porting/tests/test_*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.whl

# ── Logs and tool scratch ─────────────────────────────────────────────────────
*.log
*.npz
*.dot

